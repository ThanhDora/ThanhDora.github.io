---
import { getProfile } from '../data/localized';
import { localizePath, fmt, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const currentYear = new Date().getFullYear();
const { identity, socials } = getProfile(locale);
const home = localizePath('/', locale);
---

<footer class="border-t border-rule bg-canvas-elevated/40 text-ink-secondary no-print">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 pb-12 border-b border-rule">
      <div class="md:col-span-6 space-y-3">
        <p class="font-serif text-2xl text-ink">{identity.name} <span class="italic font-normal text-ink-secondary">· @{identity.handle}</span></p>
        <p class="max-w-md text-sm leading-relaxed text-ink-secondary">
          {fmt(ui.footer.blurb, { role: identity.role, location: identity.location })}
        </p>
      </div>

      <nav class="md:col-span-3 space-y-2.5" aria-label={ui.nav.footer}>
        <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{ui.footer.index}</p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${home}#about`} class="editorial-link hover:text-ink">01 / {ui.nav.about}</a></li>
          <li><a href={`${home}#skills`} class="editorial-link hover:text-ink">02 / {ui.nav.skills}</a></li>
          <li><a href={`${home}#projects`} class="editorial-link hover:text-ink">03 / {ui.nav.projects}</a></li>
          <li><a href={`${home}#experience`} class="editorial-link hover:text-ink">04 / {ui.nav.timeline}</a></li>
          <li><a href={`${home}#contact`} class="editorial-link hover:text-ink">05 / {ui.nav.contact}</a></li>
          <li><a href={localizePath('/resume/', locale)} class="editorial-link hover:text-ink">06 / {ui.nav.resume}</a></li>
        </ul>
      </nav>

      <div class="md:col-span-3 space-y-2.5">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{ui.footer.elsewhere}</p>
        <ul class="space-y-2 text-sm">
          {socials.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer me" class="editorial-link hover:text-ink">{s.label} ({s.handle}) <span aria-hidden="true">↗</span></a></li>
          ))}
          <li><a href={`mailto:${identity.email}`} class="editorial-link hover:text-ink break-all">{identity.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs text-ink-muted">
      <p>© {currentYear} {identity.name}</p>
      <p class="flex items-center gap-3">
        <span class="hidden md:inline">{ui.footer.pressBefore} <kbd class="rounded border border-rule px-1.5 py-0.5 text-xs text-ink">T</kbd> {ui.footer.pressAfter}</span>
        <span class="hidden md:inline" aria-hidden="true">•</span>
        <a href="#main-content" class="hover:text-sage transition-colors">{ui.footer.backToTop}</a>
      </p>
    </div>
  </div>
</footer>
