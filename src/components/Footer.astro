---
import { PROFILE_DATA } from '../data/profile';
const currentYear = new Date().getFullYear();
const { identity, socials } = PROFILE_DATA;
---

<footer class="border-t border-rule bg-canvas-elevated/40 text-ink-secondary no-print">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 pb-12 border-b border-rule">
      <div class="md:col-span-6 space-y-3">
        <p class="font-serif text-2xl text-ink">{identity.name} <span class="italic font-normal text-ink-secondary">· @{identity.handle}</span></p>
        <p class="max-w-md text-sm leading-relaxed text-ink-secondary">
          {identity.role} based in {identity.location}. Built with Astro and Tailwind CSS, hosted on GitHub Pages.
        </p>
      </div>

      <nav class="md:col-span-3 space-y-2.5" aria-label="Footer">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Index</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/#about" class="editorial-link hover:text-ink">01 / About</a></li>
          <li><a href="/#skills" class="editorial-link hover:text-ink">02 / Skills</a></li>
          <li><a href="/#projects" class="editorial-link hover:text-ink">03 / Projects</a></li>
          <li><a href="/#experience" class="editorial-link hover:text-ink">04 / Timeline</a></li>
          <li><a href="/#contact" class="editorial-link hover:text-ink">05 / Contact</a></li>
          <li><a href="/resume/" class="editorial-link hover:text-ink">06 / Resume</a></li>
        </ul>
      </nav>

      <div class="md:col-span-3 space-y-2.5">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Elsewhere</p>
        <ul class="space-y-2 text-sm">
          {socials.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer me" class="editorial-link hover:text-ink">{s.label} ({s.handle}) <span aria-hidden="true">↗</span></a></li>
          ))}
          <li><a href={`mailto:${identity.email}`} class="editorial-link hover:text-ink break-all">{identity.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs text-ink-muted">
      <p>© {currentYear} {identity.name}</p>
      <p class="flex items-center gap-3">
        <span class="hidden md:inline">Press <kbd class="rounded border border-rule px-1.5 py-0.5 text-xs text-ink">T</kbd> to switch theme</span>
        <span class="hidden md:inline" aria-hidden="true">•</span>
        <a href="#main-content" class="hover:text-sage transition-colors">Back to top ↑</a>
      </p>
    </div>
  </div>
</footer>
