---
interface Props {
  type: 'orchestrator' | 'commerce' | 'ios-atelier' | 'devops-mesh' | 'ops-ledger' | 'edge-gateway';
  index: string;
}

const { type, index } = Astro.props;
---

<div class="relative h-full w-full min-h-[220px] overflow-hidden rounded-lg border border-rule bg-canvas-elevated/80 p-5 flex flex-col justify-between group-hover:border-sage/60 transition-colors duration-500">
  <!-- Background Architectural Grid -->
  <div class="pointer-events-none absolute inset-0 atelier-grid-bg opacity-60"></div>

  <!-- Top Blueprint Header -->
  <div class="relative z-10 flex items-center justify-between border-b border-rule/80 pb-2.5 font-mono text-[10px] uppercase tracking-widest text-ink-muted">
    <span>FIG. {index} // SYSTEM TOPOLOGY</span>
    <span class="text-sage">● ACTIVE SPEC</span>
  </div>

  <!-- Center Architectural Diagram SVG -->
  <div class="relative z-10 my-4 flex flex-1 items-center justify-center">
    {type === 'orchestrator' && (
      <svg viewBox="0 0 360 140" class="w-full max-w-[340px] h-auto text-ink">
        <!-- Ingestion Node -->
        <rect x="8" y="46" width="76" height="48" rx="4" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1.2" />
        <text x="46" y="67" text-anchor="middle" class="font-mono text-[8px] fill-current">WEBHOOK</text>
        <text x="46" y="80" text-anchor="middle" class="font-mono text-[7px] fill-current opacity-60">INGEST</text>

        <!-- Arrow 1 -->
        <line x1="84" y1="70" x2="128" y2="70" stroke="#5F7A6A" stroke-width="1.5" stroke-dasharray="3 3" />
        <circle cx="106" cy="70" r="3" fill="#5F7A6A" />

        <!-- Central Agent Core -->
        <rect x="128" y="24" width="104" height="92" rx="6" fill="#5F7A6A" fill-opacity="0.12" stroke="#5F7A6A" stroke-width="1.5" />
        <text x="180" y="52" text-anchor="middle" class="font-mono text-[9px] font-semibold" fill="#5F7A6A">DORA AGENT</text>
        <text x="180" y="68" text-anchor="middle" class="font-mono text-[7.5px] fill-current opacity-80">ZOD SCHEMA GUARD</text>
        <rect x="144" y="80" width="72" height="20" rx="3" fill="currentColor" fill-opacity="0.08" />
        <text x="180" y="93" text-anchor="middle" class="font-mono text-[7px] fill-current">BULLMQ + REDIS</text>

        <!-- Outbound Branches -->
        <path d="M232 52 L272 34" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.5" />
        <path d="M232 88 L272 106" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.5" />

        <rect x="272" y="16" width="80" height="36" rx="4" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.1" />
        <text x="312" y="37" text-anchor="middle" class="font-mono text-[7.5px] fill-current">POSTGRES AUDIT</text>

        <rect x="272" y="88" width="80" height="36" rx="4" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.1" />
        <text x="312" y="109" text-anchor="middle" class="font-mono text-[7.5px] fill-current">OPS DISPATCH</text>
      </svg>
    )}

    {type === 'commerce' && (
      <svg viewBox="0 0 360 140" class="w-full max-w-[340px] h-auto text-ink">
        <!-- Edge Storefront -->
        <rect x="12" y="22" width="96" height="96" rx="5" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.2" />
        <text x="60" y="48" text-anchor="middle" class="font-mono text-[8px] font-semibold fill-current">NEXT.JS EDGE</text>
        <line x1="24" y1="58" x2="96" y2="58" stroke="currentColor" stroke-opacity="0.2" />
        <text x="60" y="76" text-anchor="middle" class="font-mono text-[7px] fill-current opacity-70">ISR CATALOG</text>
        <text x="60" y="94" text-anchor="middle" class="font-mono text-[7.5px]" fill="#5F7A6A">P95: 28ms</text>

        <!-- Bidirectional Sync -->
        <line x1="108" y1="58" x2="156" y2="58" stroke="#5F7A6A" stroke-width="1.5" />
        <line x1="108" y1="82" x2="156" y2="82" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.2" stroke-dasharray="3 3" />

        <!-- Express Ledger -->
        <rect x="156" y="30" width="92" height="80" rx="5" fill="#5F7A6A" fill-opacity="0.1" stroke="#5F7A6A" stroke-width="1.4" />
        <text x="202" y="60" text-anchor="middle" class="font-mono text-[8px] font-semibold" fill="#5F7A6A">EXPRESS CORE</text>
        <text x="202" y="76" text-anchor="middle" class="font-mono text-[7px] fill-current opacity-80">ACID LOCKING</text>
        <text x="202" y="92" text-anchor="middle" class="font-mono text-[7px] fill-current opacity-60">ZERO OVERSELL</text>

        <!-- Warehouse DB -->
        <line x1="248" y1="70" x2="278" y2="70" stroke="currentColor" stroke-width="1.2" />
        <rect x="278" y="38" width="70" height="64" rx="4" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1.2" />
        <text x="313" y="66" text-anchor="middle" class="font-mono text-[7.5px] fill-current">MULTI-NODE</text>
        <text x="313" y="80" text-anchor="middle" class="font-mono text-[7.5px] fill-current opacity-70">LEDGER DB</text>
      </svg>
    )}

    {type === 'ios-atelier' && (
      <svg viewBox="0 0 360 140" class="w-full max-w-[340px] h-auto text-ink">
        <!-- iOS Device Frame -->
        <rect x="36" y="10" width="84" height="120" rx="12" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1.4" />
        <rect x="64" y="16" width="28" height="4" rx="2" fill="currentColor" fill-opacity="0.3" />
        <rect x="46" y="30" width="64" height="28" rx="3" fill="#5F7A6A" fill-opacity="0.15" stroke="#5F7A6A" stroke-width="1" />
        <text x="78" y="47" text-anchor="middle" class="font-mono text-[7px]" fill="#5F7A6A">SWIFTUI 60FPS</text>
        <rect x="46" y="66" width="64" height="18" rx="2" fill="currentColor" fill-opacity="0.07" />
        <rect x="46" y="90" width="44" height="10" rx="2" fill="currentColor" fill-opacity="0.07" />

        <!-- Sync Engine -->
        <path d="M120 70 C 155 70, 155 70, 185 70" stroke="#5F7A6A" stroke-width="1.5" stroke-dasharray="4 3" />
        <circle cx="152" cy="70" r="14" fill="#5F7A6A" fill-opacity="0.15" stroke="#5F7A6A" stroke-width="1.2" />
        <text x="152" y="73" text-anchor="middle" class="font-mono text-[7px]" fill="#5F7A6A">CRDT</text>

        <!-- SwiftData + Cloud -->
        <rect x="185" y="28" width="145" height="84" rx="6" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.2" />
        <text x="257" y="52" text-anchor="middle" class="font-mono text-[8px] font-semibold fill-current">OFFLINE-FIRST ENGINE</text>
        <text x="257" y="70" text-anchor="middle" class="font-mono text-[7.5px] fill-current opacity-75">SWIFTDATA LOCAL STORE</text>
        <text x="257" y="90" text-anchor="middle" class="font-mono text-[7px]" fill="#5F7A6A">BACKGROUND DELTA SYNC</text>
      </svg>
    )}

    {(type === 'devops-mesh' || type === 'ops-ledger' || type === 'edge-gateway') && (
      <svg viewBox="0 0 360 140" class="w-full max-w-[340px] h-auto text-ink">
        <!-- Cloudflare Shield -->
        <rect x="14" y="34" width="88" height="72" rx="5" fill="#5F7A6A" fill-opacity="0.12" stroke="#5F7A6A" stroke-width="1.4" />
        <text x="58" y="64" text-anchor="middle" class="font-mono text-[8px] font-semibold" fill="#5F7A6A">CLOUDFLARE</text>
        <text x="58" y="79" text-anchor="middle" class="font-mono text-[7px] fill-current opacity-80">ZERO-TRUST</text>

        <!-- Encrypted Outbound Tunnel -->
        <line x1="102" y1="70" x2="178" y2="70" stroke="#5F7A6A" stroke-width="2" />
        <text x="140" y="60" text-anchor="middle" class="font-mono text-[6.5px]" fill="#5F7A6A">OUTBOUND TLS</text>
        <text x="140" y="84" text-anchor="middle" class="font-mono text-[6.5px] fill-current opacity-60">0 PUBLIC PORTS</text>

        <!-- Docker Host -->
        <rect x="178" y="18" width="166" height="104" rx="6" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 2" />
        <text x="261" y="36" text-anchor="middle" class="font-mono text-[7.5px] fill-current opacity-70">LINUX DOCKER MESH</text>
        <rect x="192" y="48" width="64" height="58" rx="4" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-width="1" />
        <text x="224" y="75" text-anchor="middle" class="font-mono text-[7.5px] fill-current">BLUE</text>
        <text x="224" y="88" text-anchor="middle" class="font-mono text-[6.5px]" fill="#5F7A6A">ACTIVE</text>

        <rect x="268" y="48" width="64" height="58" rx="4" fill="currentColor" fill-opacity="0.03" stroke="currentColor" stroke-opacity="0.4" stroke-width="1" />
        <text x="300" y="75" text-anchor="middle" class="font-mono text-[7.5px] fill-current opacity-60">GREEN</text>
        <text x="300" y="88" text-anchor="middle" class="font-mono text-[6.5px] fill-current opacity-50">STANDBY</text>
      </svg>
    )}
  </div>

  <!-- Bottom Blueprint Footer -->
  <div class="relative z-10 flex items-center justify-between border-t border-rule/80 pt-2.5 font-mono text-[10px] text-ink-muted">
    <span>ARCH: VERIFIED</span>
    <span class="group-hover:text-sage transition-colors">INSPECT SPECIFICATION →</span>
  </div>
</div>
