---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PROFILE_DATA } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: URL | string;
}

const {
  title = `${PROFILE_DATA.identity.name} (@${PROFILE_DATA.identity.handle}) — ${PROFILE_DATA.identity.role}`,
  description = PROFILE_DATA.identity.tagline,
  ogImage = 'https://thanhdora.github.io/og-image.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;

const ogImageAlt = 'Digital painting of a dark-haired woman in glasses holding a small glowing moon-like sphere against a starry, golden-lit backdrop';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE_DATA.identity.name,
  alternateName: PROFILE_DATA.identity.handle,
  jobTitle: PROFILE_DATA.identity.role,
  url: Astro.site?.toString() || 'https://thanhdora.github.io/',
  email: `mailto:${PROFILE_DATA.identity.email}`,
  sameAs: PROFILE_DATA.socials.map((s) => s.url),
  knowsAbout: ['Next.js', 'React', 'TypeScript', 'Node.js', 'Express', 'PostgreSQL', 'Swift', 'iOS Development', 'Python', 'Telegram Bots'],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE_DATA.identity.name} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={PROFILE_DATA.identity.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:secure_url" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#F5F1EB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161412" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Immediate Theme Initialization (prevents FOUC) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('atelier-theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas text-ink selection:bg-sage/20 selection:text-ink transition-colors duration-300 relative overflow-x-hidden">
    <!-- Subtle Tactile Paper Grain Overlay -->
    <div class="pointer-events-none fixed inset-0 z-50 atelier-grain" aria-hidden="true"></div>

    <!-- Top Architectural Accent Hairline -->
    <div class="h-[2px] w-full bg-gradient-to-r from-sage/40 via-sage to-sage/40 no-print" aria-hidden="true"></div>

    <Header />

    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
