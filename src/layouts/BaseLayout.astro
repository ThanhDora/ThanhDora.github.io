---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile } from '../data/localized';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, localizePath, splitPath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: URL | string;
  /** Defaults to the locale in the URL. */
  locale?: Locale;
  /** Emit hreflang alternates (off for the 404 page). */
  alternates?: boolean;
}

const fromUrl = splitPath(Astro.url.pathname);
const locale: Locale = Astro.props.locale ?? fromUrl.locale;
const route = fromUrl.route;
const PROFILE_DATA = getProfile(locale);
const ui = t(locale);
const meta = LOCALE_META[locale];

const {
  title = `${PROFILE_DATA.identity.name} (@${PROFILE_DATA.identity.handle}) — ${PROFILE_DATA.identity.role}`,
  description = PROFILE_DATA.identity.tagline,
  ogImage = 'https://thanhdora.github.io/og-image.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  alternates = true,
} = Astro.props;

const ogImageAlt = ui.meta.ogImageAlt;
const altLinks = alternates
  ? [
      ...LOCALES.map((l) => ({ hreflang: LOCALE_META[l].hreflang, href: new URL(localizePath(route, l), Astro.site).toString() })),
      { hreflang: 'x-default', href: new URL(localizePath(route, DEFAULT_LOCALE), Astro.site).toString() },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE_DATA.identity.name,
  alternateName: PROFILE_DATA.identity.handle,
  jobTitle: PROFILE_DATA.identity.role,
  url: new URL(localizePath('/', locale), Astro.site).toString(),
  email: `mailto:${PROFILE_DATA.identity.email}`,
  sameAs: PROFILE_DATA.socials.map((s) => s.url),
  knowsAbout: ['Next.js', 'React', 'TypeScript', 'Node.js', 'Express', 'PostgreSQL', 'Swift', 'iOS Development', 'Python', 'Telegram Bots'],
};
---

<!doctype html>
<html lang={meta.htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE_DATA.identity.name} />
    <link rel="canonical" href={canonicalURL} />
    {altLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={PROFILE_DATA.identity.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {alternates && LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:secure_url" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#F5F1EB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161412" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Immediate Theme Initialization (prevents FOUC) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('atelier-theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- Motion: enable before first paint (skipped for reduced motion / no JS) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        d.classList.add('motion');
        // Fail-safe: if the reveal script never runs, show everything.
        setTimeout(function () { if (!window.__atelierReveal) d.classList.remove('motion'); }, 3000);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas text-ink selection:bg-sage/20 selection:text-ink transition-colors duration-300 relative overflow-x-hidden">
    <!-- Subtle Tactile Paper Grain Overlay -->
    <div class="pointer-events-none fixed inset-0 z-50 atelier-grain" aria-hidden="true"></div>

    <!-- Top Architectural Accent Hairline -->
    <div class="h-[2px] w-full bg-gradient-to-r from-sage/40 via-sage to-sage/40 no-print" aria-hidden="true"></div>

    <Header locale={locale} route={route} />

    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      // Reveal-on-scroll: each element animates once, with a small stagger among
      // elements that enter together.
      (window as any).__atelierReveal = true;
      const root = document.documentElement;
      if (root.classList.contains('motion')) {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-children] > *')
        );
        // After the reveal, hand transitions back to the element's own classes (hover effects).
        const show = (el: HTMLElement, delay = 0) => {
          el.style.setProperty('--rd', `${delay}ms`);
          el.classList.add('is-in');
          window.setTimeout(() => el.classList.add('is-done'), delay + 750);
        };
        const io = new IntersectionObserver(
          (entries) => {
            const entering = entries
              .filter((e) => e.isIntersecting)
              .map((e) => e.target as HTMLElement)
              .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top || a.getBoundingClientRect().left - b.getBoundingClientRect().left);
            entering.forEach((el, i) => {
              show(el, Math.min(i, 6) * 80);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        targets.forEach((el) => io.observe(el));

        // Content targeted by #hash (and everything above it) is shown right away.
        const revealHash = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          const target = id && document.getElementById(id);
          if (!target) return;
          const top = target.getBoundingClientRect().top;
          targets.forEach((el) => {
            if (!el.classList.contains('is-in') && (target.contains(el) || el.getBoundingClientRect().top < top + window.innerHeight)) {
              show(el);
              io.unobserve(el);
            }
          });
        };
        revealHash();
        window.addEventListener('hashchange', revealHash);
        window.addEventListener('beforeprint', () => targets.forEach((el) => show(el)));
      }
    </script>
  </body>
</html>
