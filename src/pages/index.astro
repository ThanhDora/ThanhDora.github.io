---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE_DATA } from '../data/profile';
import { formatMonth, projectPath } from '../lib/format';

const { identity, hero, about, skills, projects, experience, education, socials } = PROFILE_DATA;
const projectCategories = ['All', ...new Set(projects.map((p) => p.category))];

const timeline = [...projects].sort((a, b) => b.started.localeCompare(a.started));
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative border-b border-rule pt-12 pb-16 sm:pt-20 sm:pb-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4 border-b border-rule/80 pb-4 font-mono text-xs text-ink-muted animate-quiet-in">
        <div class="flex items-center gap-2.5">
          <span class="inline-block h-2 w-2 rounded-full bg-sage" aria-hidden="true"></span>
          <span class="tracking-widest uppercase">{hero.label}</span>
        </div>
        <span>{identity.timezone}</span>
      </div>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8 space-y-8 animate-quiet-in delay-100">
          <h1 class="font-serif text-4xl leading-[1.12] tracking-editorial text-ink sm:text-6xl lg:text-[64px]">
            {hero.headlinePrefix}{' '}
            <span class="italic font-normal text-sage">{hero.headlineItalic}</span>{' '}
            {hero.headlineSuffix}
          </h1>
          <p class="max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">{hero.lead}</p>
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href="#projects" class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-canvas transition-all duration-300 hover:bg-sage-deep">
              <span>See projects</span><span class="font-mono text-xs" aria-hidden="true">↓</span>
            </a>
            <a href="/resume/" class="inline-flex items-center gap-2.5 rounded-full border border-rule-strong bg-canvas-elevated/60 px-6 py-3.5 text-sm font-medium text-ink transition-all duration-300 hover:border-sage hover:text-sage">
              <span>Resume</span><span class="font-mono text-xs" aria-hidden="true">↗</span>
            </a>
            <a href="#contact" class="px-3 py-2 text-sm font-medium text-ink-secondary hover:text-ink editorial-link">Contact →</a>
          </div>
        </div>

        <div class="lg:col-span-4 animate-quiet-in delay-200">
          <aside class="relative rounded-xl border border-rule bg-canvas-elevated/70 p-6 shadow-sm">
            <div class="flex items-start justify-between border-b border-rule pb-4">
              <div>
                <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">At a glance</p>
                <p class="mt-1 font-serif text-2xl font-medium text-ink">{identity.name}</p>
                <p class="text-sm text-ink-secondary">@{identity.handle} · {identity.role}</p>
              </div>
              <div class="flex h-11 w-11 items-center justify-center rounded-full border border-sage/40 bg-sage/10 font-serif text-lg italic text-sage-deep" aria-hidden="true">
                {identity.monogram}
              </div>
            </div>
            <dl class="mt-4 space-y-3 font-mono text-xs">
              <div class="flex justify-between gap-4 border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">WEB</dt><dd class="text-ink font-medium text-right">Next.js · Express · PostgreSQL</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">MOBILE</dt><dd class="text-ink font-medium text-right">Swift · SwiftUI</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">BOTS</dt><dd class="text-ink font-medium text-right">Python · Telegram</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">GITHUB</dt>
                <dd class="text-right"><a href={identity.github} target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-sage">github.com/{identity.handle}</a></dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="scroll-mt-16 border-b border-rule py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4 space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">01 / About</p>
          <h2 class="font-serif text-3xl leading-snug text-ink sm:text-4xl">{about.heading}</h2>
        </div>
        <div class="lg:col-span-8 space-y-5 text-base leading-relaxed text-ink-secondary sm:text-lg">
          {about.paragraphs.map((p, i) => (
            <p class={i === 0 ? 'font-serif text-xl sm:text-2xl text-ink leading-relaxed' : ''}>{p}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="scroll-mt-16 border-b border-rule bg-canvas-elevated/30 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="border-b border-rule pb-8">
        <p class="font-mono text-xs uppercase tracking-widest text-sage">02 / Skills</p>
        <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">Tools I <span class="italic font-normal text-sage">work with</span></h2>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((group) => (
          <div>
            <h3 class="font-serif text-xl font-medium text-ink">{group.category}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-rule bg-canvas px-3 py-1 text-sm text-ink-secondary">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="scroll-mt-16 border-b border-rule py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-col justify-between gap-6 border-b border-rule pb-8 lg:flex-row lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-sage">03 / Projects</p>
          <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">Selected <span class="italic font-normal text-sage">projects</span></h2>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
          {projectCategories.map((category, index) => (
            <button
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-filter={category}
              class="project-filter-btn rounded-full border border-rule bg-canvas-elevated/50 px-3.5 py-1.5 font-mono text-xs text-ink-secondary transition-all duration-200 hover:border-sage hover:text-ink"
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2" id="projects-grid">
        {projects.map((project) => (
          <article
            id={project.id}
            data-category={project.category}
            class="project-card group relative flex flex-col rounded-2xl border border-rule bg-canvas-elevated/30 p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-sage/70 hover:bg-canvas-elevated/60 hover:shadow-sm focus-within:border-sage sm:p-7"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-ink-muted">
              <span class="rounded bg-sage/10 px-2 py-0.5 text-sage-deep">{project.category}</span>
              <span>Started {formatMonth(project.started)}{project.status ? ` · ${project.status}` : ''}</span>
            </div>
            <h3 class="mt-3 font-serif text-2xl font-medium text-ink">
              <a href={projectPath(project.id)} class="card-link transition-colors group-hover:text-sage-deep">{project.title}</a>
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-secondary sm:text-base">{project.summary}</p>
            <ul class="mt-4 space-y-1.5">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-2 text-sm text-ink-secondary">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sage" aria-hidden="true"></span><span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-5">
              <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
                {project.stack.map((tech) => (
                  <li class="rounded border border-rule bg-canvas px-2.5 py-0.5 font-mono text-xs text-ink-secondary">{tech}</li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-rule/80 pt-4 font-mono text-sm">
                <span class="mr-auto inline-flex items-center gap-1 font-medium text-sage-deep" aria-hidden="true">
                  View details <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
                {project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1 font-medium text-ink hover:text-sage editorial-link" aria-label={`${project.title} live site (opens in new tab)`}>
                    Live site <span aria-hidden="true">↗</span>
                  </a>
                )}
                <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1 text-ink-secondary hover:text-ink editorial-link" aria-label={`${project.title} source on GitHub (opens in new tab)`}>
                  Source <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TIMELINE / EXPERIENCE -->
  <section id="experience" class="scroll-mt-16 border-b border-rule bg-canvas-elevated/30 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4 space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">04 / Timeline</p>
          <h2 class="font-serif text-3xl text-ink sm:text-4xl">Experience <span class="italic font-normal text-sage">&amp; projects</span></h2>
          <p class="text-sm leading-relaxed text-ink-secondary">Project dates are when each repository was created on GitHub.</p>
        </div>

        <div class="lg:col-span-8 space-y-10">
          {experience.length > 0 && (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-ink-muted">Work experience</h3>
              <div class="mt-4 divide-y divide-rule">
                {experience.map((item) => (
                  <div class="py-6 first:pt-0">
                    <p class="font-mono text-xs font-medium text-sage">{item.period}</p>
                    <p class="mt-1 font-serif text-xl font-medium text-ink">{item.role}</p>
                    <p class="text-sm font-medium text-ink-secondary">{item.organization}{item.location ? ` · ${item.location}` : ''}</p>
                    <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{item.summary}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {education.length > 0 && (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-ink-muted">Education</h3>
              <ul class="mt-4 space-y-3">
                {education.map((e) => (
                  <li class="text-sm text-ink-secondary"><span class="font-mono text-xs text-sage">{e.period}</span> · <span class="font-medium text-ink">{e.degree}</span>, {e.school}</li>
                ))}
              </ul>
            </div>
          )}

          <div>
            <h3 class="font-mono text-xs uppercase tracking-widest text-ink-muted">Open-source &amp; personal projects</h3>
            <ol class="mt-4 border-l border-rule">
              {timeline.map((p) => (
                <li class="relative pb-5 pl-6 last:pb-0">
                  <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-canvas bg-sage" aria-hidden="true"></span>
                  <p class="font-mono text-xs text-sage-deep">{formatMonth(p.started)}</p>
                  <p class="mt-0.5 text-sm text-ink-secondary">
                    <a href={projectPath(p.id)} class="font-medium text-ink hover:text-sage">{p.title}</a> · {p.category}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="scroll-mt-16 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5 space-y-6">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">05 / Contact</p>
          <h2 class="font-serif text-3xl leading-tight text-ink sm:text-5xl">Get in <span class="italic font-normal text-sage">touch.</span></h2>
          <p class="text-sm leading-relaxed text-ink-secondary sm:text-base">Have a project or an idea you want to talk about? Send me an email.</p>

          <div class="rounded-xl border border-rule bg-canvas-elevated/60 p-5">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Email</p>
            <div class="mt-2 flex items-center justify-between gap-3">
              <a href={`mailto:${identity.email}`} class="font-mono text-sm font-medium text-ink hover:text-sage break-all">{identity.email}</a>
              <button id="copy-email-btn" type="button" data-email={identity.email} class="shrink-0 rounded-full border border-rule bg-canvas px-3 py-1.5 font-mono text-xs text-ink-secondary transition-colors hover:border-sage hover:text-sage">Copy</button>
            </div>
          </div>

          <ul class="space-y-1 pt-2 font-mono text-sm">
            {socials.map((s) => (
              <li class="flex items-center justify-between border-b border-rule/70 py-2.5">
                <span class="text-ink-muted">{s.label}</span>
                <a href={s.url} target="_blank" rel="noopener noreferrer me" class="text-ink hover:text-sage editorial-link">{s.handle} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-7">
          <form id="contact-form" class="rounded-2xl border border-rule bg-canvas-elevated/50 p-6 sm:p-8 space-y-6">
            <p class="border-b border-rule pb-4 font-mono text-xs uppercase tracking-widest text-ink">Write a message</p>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="sender-name" class="block font-mono text-xs uppercase tracking-wider text-ink-muted">Your name *</label>
                <input id="sender-name" name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-lg border border-rule bg-canvas px-4 py-2.5 text-sm text-ink focus:border-sage focus:outline-none" />
              </div>
              <div>
                <label for="sender-email" class="block font-mono text-xs uppercase tracking-wider text-ink-muted">Your email *</label>
                <input id="sender-email" name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-lg border border-rule bg-canvas px-4 py-2.5 text-sm text-ink focus:border-sage focus:outline-none" />
              </div>
            </div>
            <div>
              <label for="inquiry-message" class="block font-mono text-xs uppercase tracking-wider text-ink-muted">Message *</label>
              <textarea id="inquiry-message" name="message" rows="4" required class="mt-2 w-full rounded-lg border border-rule bg-canvas px-4 py-2.5 text-sm text-ink focus:border-sage focus:outline-none"></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <p id="form-feedback" class="font-mono text-xs text-ink-muted">Opens your email app with the message filled in.</p>
              <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-ink px-7 py-3 text-sm font-medium text-canvas transition-all duration-200 hover:bg-sage-deep">
                <span>Send</span><span class="font-mono text-xs" aria-hidden="true">→</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { PROFILE_DATA } from '../data/profile';
import { formatMonth, projectPath } from '../lib/format';
  const EMAIL = PROFILE_DATA.identity.email;

  // Project filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter || 'All';
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      projectCards.forEach((card) => {
        card.style.display = selected === 'All' || card.dataset.category === selected ? '' : 'none';
      });
    });
  });

  // Copy email
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(EMAIL);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied ✓';
      setTimeout(() => (copyBtn.textContent = original), 2200);
    } catch {
      window.location.href = `mailto:${EMAIL}`;
    }
  });

  // Contact form → mailto
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '');
    const email = String(data.get('email') || '');
    const message = String(data.get('message') || '');
    const subject = encodeURIComponent(`Message from ${name} via thanhdora.github.io`);
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
    window.location.href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
  });
</script>
