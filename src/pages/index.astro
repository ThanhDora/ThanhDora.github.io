            <div class="flex items-center justify-between border-b border-rule pb-4">
              <span class="font-mono text-xs uppercase tracking-widest text-ink">DISPATCH MESSAGE</span>
              <span class="font-mono text-[11px] text-sage">● DIRECT TO INBOX</span>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="sender-name" class="block font-mono text-[11px] uppercase tracking-wider text-ink-muted">
