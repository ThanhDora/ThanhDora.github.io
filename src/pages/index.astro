---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { PROFILE_DATA } from '../data/profile';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = allPosts.slice(0, 3);

const projectCategories = ['All', 'Full-Stack', 'AI & Automation', 'iOS & Mobile', 'DevOps & Cloud'];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout>
  <!-- ==========================================
       HERO SECTION — EDITORIAL MONOGRAPH MASTHEAD
       ========================================== -->
  <section class="relative border-b border-rule pt-12 pb-20 sm:pt-20 sm:pb-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <!-- Top Editorial Metadata Strip -->
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4 border-b border-rule/80 pb-4 font-mono text-xs text-ink-muted animate-quiet-in">
        <div class="flex items-center gap-2.5">
          <span class="inline-block h-2 w-2 rounded-full bg-sage"></span>
          <span class="tracking-widest uppercase">{PROFILE_DATA.hero.editionLabel}</span>
        </div>
        <div class="flex items-center gap-4">
          <span>{PROFILE_DATA.identity.location}</span>
          <span class="hidden sm:inline text-rule-strong">•</span>
          <span class="hidden sm:inline text-sage font-medium">{PROFILE_DATA.identity.status}</span>
        </div>
      </div>

      <!-- Main Asymmetric Hero Grid -->
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-end">
        <!-- Left 8 Columns: Editorial Display Typography -->
        <div class="lg:col-span-8 space-y-8 animate-quiet-in delay-100">
          <h1 class="font-serif text-4xl leading-[1.12] tracking-editorial text-ink sm:text-6xl lg:text-[64px]">
            {PROFILE_DATA.hero.headlinePrefix}{' '}
            <span class="italic font-normal text-sage">{PROFILE_DATA.hero.headlineItalic}</span>{' '}
            {PROFILE_DATA.hero.headlineSuffix}
          </h1>

          <p class="max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">
            {PROFILE_DATA.hero.lead}
          </p>

          <!-- Primary Action Bar -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#projects"
              class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-canvas transition-all duration-300 hover:bg-sage"
            >
              <span>Explore Selected Works</span>
              <span class="font-mono text-xs">↓</span>
            </a>

            <a
              href="/resume"
              class="inline-flex items-center gap-2.5 rounded-full border border-rule-strong bg-canvas-elevated/60 px-6 py-3.5 text-sm font-medium text-ink transition-all duration-300 hover:border-sage hover:text-sage"
            >
              <span>Curriculum Vitae</span>
              <span class="font-mono text-xs">↗</span>
            </a>

            <a
              href="#contact"
              class="px-3 py-2 text-sm font-medium text-ink-secondary hover:text-ink editorial-link"
            >
              Direct Inquiry →
            </a>
          </div>
        </div>

        <!-- Right 4 Columns: Architect's Dossier Card -->
        <div class="lg:col-span-4 animate-quiet-in delay-200">
          <aside class="relative rounded-xl border border-rule bg-canvas-elevated/70 p-6 shadow-sm">
            <div class="flex items-start justify-between border-b border-rule pb-4">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">ARCHITECT DOSSIER</p>
                <h2 class="mt-1 font-serif text-2xl font-medium text-ink">{PROFILE_DATA.identity.name}</h2>
                <p class="text-xs text-ink-secondary">{PROFILE_DATA.identity.legalName} • {PROFILE_DATA.identity.role}</p>
              </div>
              <div class="flex h-11 w-11 items-center justify-center rounded-full border border-sage/40 bg-sage/10 font-serif text-lg italic text-sage">
                {PROFILE_DATA.identity.monogram}
              </div>
            </div>

            <dl class="mt-4 space-y-3 font-mono text-xs">
              <div class="flex justify-between border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">PRIMARY STACK</dt>
                <dd class="text-ink font-medium text-right">Next.js • Node.js • Swift</dd>
              </div>
              <div class="flex justify-between border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">INFRASTRUCTURE</dt>
                <dd class="text-ink font-medium text-right">Docker • Cloudflare • Linux</dd>
              </div>
              <div class="flex justify-between border-b border-rule/60 pb-2">
                <dt class="text-ink-muted">SPECIALIZATION</dt>
                <dd class="text-sage font-medium text-right">Applied AI &amp; Ops Systems</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-muted">DOMAIN</dt>
                <dd class="text-ink font-medium text-right">{PROFILE_DATA.identity.domain}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>

      <!-- Bottom Metrics Strip -->
      <div class="mt-16 grid grid-cols-1 gap-6 border-t border-rule pt-8 sm:grid-cols-3 animate-quiet-in delay-300">
        {PROFILE_DATA.hero.metrics.map((metric, idx) => (
          <div class="flex flex-col justify-between border-l-2 border-sage/50 pl-4">
            <div class="flex items-baseline justify-between">
              <span class="font-serif text-3xl font-semibold text-ink sm:text-4xl">{metric.value}</span>
              <span class="font-mono text-[10px] text-ink-muted">0{idx + 1}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-ink">{metric.label}</p>
            <p class="text-xs text-ink-muted">{metric.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 01 — ABOUT & ARCHITECTURAL ETHOS
       ========================================== -->
  <section id="about" class="scroll-mt-16 border-b border-rule py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Section Index Column -->
        <div class="lg:col-span-4 space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">
            § {PROFILE_DATA.about.sectionIndex}
          </p>
          <h2 class="font-serif text-3xl leading-snug text-ink sm:text-4xl">
            {PROFILE_DATA.about.heading}
          </h2>
          <div class="h-[1px] w-16 bg-sage/60"></div>
          <p class="font-mono text-xs leading-relaxed text-ink-muted pt-2">
            Full-stack craftsmanship rooted in clarity, operational resilience, and thoughtful human interfaces.
          </p>
        </div>

        <!-- Narrative & Principles Column -->
        <div class="lg:col-span-8 space-y-10">
          <div class="space-y-5 text-base leading-relaxed text-ink-secondary sm:text-lg">
            {PROFILE_DATA.about.paragraphs.map((paragraph, i) => (
              <p class={i === 0 ? 'font-serif text-xl sm:text-2xl text-ink leading-relaxed' : ''}>
                {paragraph}
              </p>
            ))}
          </div>

          <!-- 3 Architectural Principles -->
          <div class="grid grid-cols-1 gap-6 border-t border-rule pt-8 sm:grid-cols-3">
            {PROFILE_DATA.about.principles.map((p) => (
              <div class="rounded-lg border border-rule bg-canvas-elevated/40 p-5 transition-colors hover:border-sage/60">
                <span class="font-serif text-lg italic text-sage">{p.number}.</span>
                <h3 class="mt-2 font-serif text-lg font-medium text-ink">{p.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-ink-secondary">{p.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 02 — TECHNICAL CAPABILITIES MATRIX
       ========================================== -->
  <section id="skills" class="scroll-mt-16 border-b border-rule bg-canvas-elevated/30 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-col justify-between gap-4 border-b border-rule pb-8 md:flex-row md:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-sage">§ 02 / TECHNICAL CAPABILITIES</p>
          <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">
            Disciplines &amp; <span class="italic font-normal text-sage">Production Stack</span>
          </h2>
        </div>
        <p class="max-w-md text-sm text-ink-secondary">
          Organized by architectural layer — from reactive frontend interfaces and native iOS clients to distributed backends, DevOps, and autonomous AI workflows.
        </p>
      </div>

      <!-- Capabilities Grid -->
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {PROFILE_DATA.skills.map((group, idx) => (
          <article
            class:list={[
              'flex flex-col justify-between rounded-xl border border-rule bg-canvas p-6 transition-all duration-300 hover:border-sage/70',
              idx === 4 ? 'md:col-span-2 lg:col-span-2' : '',
            ]}
          >
            <div>
              <div class="flex items-center justify-between border-b border-rule/80 pb-3">
                <span class="font-mono text-[11px] uppercase tracking-widest text-sage">{group.code}</span>
                <span class="font-mono text-[10px] text-ink-muted">{group.items.length} MODULES</span>
              </div>

              <h3 class="mt-4 font-serif text-xl font-medium text-ink">{group.category}</h3>
              <p class="mt-1 text-xs leading-relaxed text-ink-muted">{group.subtitle}</p>

              <ul class="mt-6 divide-y divide-rule/60">
                {group.items.map((skill) => (
                  <li class="py-3 first:pt-0 last:pb-0">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="text-sm font-semibold text-ink">{skill.name}</span>
                      <span
                        class:list={[
                          'rounded px-1.5 py-0.5 font-mono text-[10px] uppercase',
                          skill.proficiency === 'Core'
                            ? 'bg-sage/15 text-sage font-medium'
                            : 'bg-canvas-subtle text-ink-muted',
                        ]}
                      >
                        {skill.proficiency}
                      </span>
                    </div>
                    <p class="mt-0.5 text-xs text-ink-secondary">{skill.detail}</p>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 03 — SELECTED WORKS (PROJECTS)
       ========================================== -->
  <section id="projects" class="scroll-mt-16 border-b border-rule py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <!-- Header + Interactive Category Filter -->
      <div class="flex flex-col justify-between gap-6 border-b border-rule pb-8 lg:flex-row lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-sage">§ 03 / SELECTED WORKS</p>
          <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">
            Architectural <span class="italic font-normal text-sage">Case Studies</span>
          </h2>
        </div>

        <!-- Category Filter Buttons -->
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter projects by domain">
          {projectCategories.map((category, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-filter={category}
              class:list={[
                'project-filter-btn rounded-full border px-3.5 py-1.5 font-mono text-xs transition-all duration-200',
                index === 0
                  ? 'border-ink bg-ink text-canvas hover:text-canvas'
                  : 'border-rule bg-canvas-elevated/50 text-ink-secondary hover:border-sage hover:text-ink',
              ]}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <!-- Project Case Studies List -->
      <div class="mt-12 space-y-12" id="projects-grid">
        {PROFILE_DATA.projects.map((project) => (
          <article
            data-category={project.category}
            class="project-card group grid grid-cols-1 gap-8 rounded-2xl border border-rule bg-canvas-elevated/30 p-6 transition-all duration-300 hover:border-sage/70 hover:bg-canvas-elevated/60 sm:p-8 lg:grid-cols-12"
          >
            <!-- Left 5 Columns: Architectural Schematic Visual -->
            <div class="lg:col-span-5 flex flex-col">
              <ProjectVisual type={project.previewType} index={project.index} />
            </div>

            <!-- Right 7 Columns: Specification & Impact -->
            <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
              <div>
                <!-- Meta Header -->
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-ink-muted">
                  <div class="flex items-center gap-2">
                    <span class="text-sage font-semibold">NO. {project.index}</span>
                    <span>•</span>
                    <span class="rounded bg-sage/10 px-2 py-0.5 text-sage">{project.category}</span>
                  </div>
                  <span>{project.year} — {project.role}</span>
                </div>

                <!-- Title & Subtitle -->
                <h3 class="mt-3 font-serif text-2xl font-medium text-ink group-hover:text-sage transition-colors sm:text-3xl">
                  {project.title}
                </h3>
                <p class="mt-1 font-serif italic text-sm text-ink-secondary">{project.subtitle}</p>

                <!-- Summary -->
                <p class="mt-4 text-sm leading-relaxed text-ink-secondary sm:text-base">
                  {project.summary}
                </p>

                <!-- Architecture Note & Impact Metrics -->
                <div class="mt-5 rounded-lg border border-rule/80 bg-canvas/70 p-4">
                  <p class="font-mono text-[10px] uppercase tracking-widest text-sage">
                    ARCHITECTURE &amp; MEASURED IMPACT
                  </p>
                  <p class="mt-1 text-xs text-ink-secondary">{project.architectureNote}</p>
                  <ul class="mt-3 grid grid-cols-1 gap-1.5 sm:grid-cols-3">
                    {project.impactMetrics.map((metric) => (
                      <li class="flex items-start gap-1.5 text-xs font-medium text-ink">
                        <span class="text-sage">✓</span>
                        <span>{metric}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Stack Pills & Links -->
              <div class="flex flex-col justify-between gap-4 border-t border-rule/80 pt-4 sm:flex-row sm:items-center">
                <div class="flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span class="rounded border border-rule bg-canvas px-2.5 py-0.5 font-mono text-[11px] text-ink-secondary">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-4 font-mono text-xs shrink-0">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-medium text-ink hover:text-sage editorial-link"
                    >
                      <span>Live System</span>
                      <span>↗</span>
                    </a>
                  )}
                  {project.repoUrl && (
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-ink-secondary hover:text-ink editorial-link"
                    >
                      <span>Source</span>
                      <span>↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 04 — EXPERIENCE & EDUCATION
       ========================================== -->
  <section id="experience" class="scroll-mt-16 border-b border-rule bg-canvas-elevated/30 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Left 4 Columns -->
        <div class="lg:col-span-4 space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">§ 04 / CHRONICLE</p>
          <h2 class="font-serif text-3xl text-ink sm:text-4xl">
            Experience &amp; <span class="italic font-normal text-sage">Foundations</span>
          </h2>
          <p class="text-sm leading-relaxed text-ink-secondary">
            A progression of independent systems architecture, full-stack product engineering, and computer science foundations.
          </p>
          <div class="pt-4">
            <a
              href="/resume"
              class="inline-flex items-center gap-2 rounded-full border border-rule-strong bg-canvas px-5 py-2.5 font-mono text-xs text-ink transition-colors hover:border-sage hover:text-sage"
            >
              <span>View Full Printable CV</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Right 8 Columns: Timeline -->
        <div class="lg:col-span-8 divide-y divide-rule">
          {PROFILE_DATA.experience.map((item) => (
            <div class="py-8 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-xs font-medium text-sage">{item.period}</span>
                <span class="rounded border border-rule px-2 py-0.5 font-mono text-[10px] uppercase text-ink-muted">
                  {item.type} • {item.location}
                </span>
              </div>

              <h3 class="mt-2 font-serif text-2xl font-medium text-ink">{item.role}</h3>
              <p class="text-sm font-medium text-ink-secondary">{item.organization}</p>

              <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{item.summary}</p>

              <ul class="mt-4 space-y-2">
                {item.highlights.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-secondary">
                    <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-sage shrink-0"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {item.technologies.map((tech) => (
                  <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[11px] text-ink-muted border border-rule/70">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 05 — ATELIER JOURNAL / NOTES
       ========================================== -->
  <section id="writing" class="scroll-mt-16 border-b border-rule py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-col justify-between gap-4 border-b border-rule pb-8 sm:flex-row sm:items-end">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-sage">§ 05 / ATELIER NOTES</p>
          <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">
            Technical <span class="italic font-normal text-sage">Monographs &amp; Essays</span>
          </h2>
        </div>
        <a
          href="/blog"
          class="font-mono text-xs uppercase tracking-widest text-ink hover:text-sage editorial-link"
        >
          Read All Archives ({allPosts.length}) →
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
        {recentPosts.map((post, idx) => (
          <article class="group flex flex-col justify-between rounded-xl border border-rule bg-canvas-elevated/30 p-6 transition-all duration-300 hover:border-sage/70 hover:bg-canvas-elevated/60">
            <div>
              <div class="flex items-center justify-between font-mono text-[11px] text-ink-muted">
                <span class="text-sage">NOTE 0{idx + 1}</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </div>

              <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-ink-muted">
                {post.data.category} • {post.data.readingTime}
              </p>

              <h3 class="mt-2 font-serif text-xl font-medium leading-snug text-ink group-hover:text-sage transition-colors">
                <a href={`/blog/${post.slug}`} class="focus:outline-none">
                  {post.data.title}
                </a>
              </h3>

              <p class="mt-3 text-xs leading-relaxed text-ink-secondary line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="mt-6 border-t border-rule/70 pt-4 flex items-center justify-between">
              <div class="flex gap-1.5">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="font-mono text-[10px] text-ink-muted">#{tag}</span>
                ))}
              </div>
              <a
                href={`/blog/${post.slug}`}
                class="font-mono text-xs font-medium text-ink group-hover:text-sage"
              >
                Read Essay →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 06 — CONTACT & INQUIRIES
       ========================================== -->
  <section id="contact" class="scroll-mt-16 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Left 5 Columns: Direct Channels & Copy Email -->
        <div class="lg:col-span-5 space-y-6">
          <p class="font-mono text-xs uppercase tracking-widest text-sage">§ 06 / INQUIRIES &amp; DIALOGUE</p>
          <h2 class="font-serif text-3xl leading-tight text-ink sm:text-5xl">
            Let’s build something <span class="italic font-normal text-sage">enduring.</span>
          </h2>
          <p class="text-sm leading-relaxed text-ink-secondary sm:text-base">
            Whether you need an end-to-end full-stack platform, native iOS engineering, cloud DevOps hardening, or custom AI operational tooling, I would love to hear about your mandate.
          </p>

          <!-- Direct Email Copy Box -->
          <div class="rounded-xl border border-rule bg-canvas-elevated/60 p-5">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">DIRECT ELECTRONIC MAIL</p>
            <div class="mt-2 flex items-center justify-between gap-3">
              <a
                href={`mailto:${PROFILE_DATA.identity.email}`}
                class="font-mono text-sm font-medium text-ink hover:text-sage break-all"
              >
                {PROFILE_DATA.identity.email}
              </a>
              <button
                id="copy-email-btn"
                type="button"
                data-email={PROFILE_DATA.identity.email}
                class="shrink-0 rounded-full border border-rule bg-canvas px-3 py-1 font-mono text-[11px] text-ink-secondary transition-colors hover:border-sage hover:text-sage"
              >
                Copy Address
              </button>
            </div>
          </div>

          <!-- Social & Architectural Links -->
          <div class="space-y-2 pt-2 font-mono text-xs">
            <div class="flex items-center justify-between border-b border-rule/70 py-2.5">
              <span class="text-ink-muted">GITHUB</span>
              <a href={PROFILE_DATA.identity.github} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sage editorial-link">
                github.com/ThanhDora ↗
              </a>
            </div>
            <div class="flex items-center justify-between border-b border-rule/70 py-2.5">
              <span class="text-ink-muted">LINKEDIN</span>
              <a href={PROFILE_DATA.identity.linkedin} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sage editorial-link">
                linkedin.com/in/thanhdora ↗
              </a>
            </div>
            <div class="flex items-center justify-between border-b border-rule/70 py-2.5">
              <span class="text-ink-muted">FACEBOOK</span>
              <a href={PROFILE_DATA.identity.facebook} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sage editorial-link">
                facebook.com/ThanhDora ↗
              </a>
            </div>
            <div class="flex items-center justify-between border-b border-rule/70 py-2.5">
              <span class="text-ink-muted">X (TWITTER)</span>
              <a href={PROFILE_DATA.identity.x} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sage editorial-link">
                x.com/ThanhDora ↗
              </a>
            </div>
            <div class="flex items-center justify-between border-b border-rule/70 py-2.5">
              <span class="text-ink-muted">PRIMARY DOMAIN</span>
              <a href={`https://${PROFILE_DATA.identity.domain}`} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-sage editorial-link">
                {PROFILE_DATA.identity.domain} ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Right 7 Columns: Editorial Dispatch Form -->
        <div class="lg:col-span-7">
          <form
            id="atelier-contact-form"
            class="rounded-2xl border border-rule bg-canvas-elevated/50 p-6 sm:p-8 space-y-6"
