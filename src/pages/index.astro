<script>
  // 1. Project Category Filtering
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter') || 'All';

      filterBtns.forEach((b) => {
        b.classList.remove('border-ink', 'bg-ink', 'text-canvas', 'hover:text-canvas');
        b.classList.add(
          'border-rule',
          'bg-canvas-elevated/50',
          'text-ink-secondary',
          'hover:border-sage',
          'hover:text-ink'
        );
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.remove(
        'border-rule',
        'bg-canvas-elevated/50',
        'text-ink-secondary',
        'hover:border-sage',
        'hover:text-ink'
      );
      btn.classList.add('border-ink', 'bg-ink', 'text-canvas', 'hover:text-canvas');
      btn.setAttribute('aria-selected', 'true');

      projectCards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (selected === 'All' || cardCat === selected) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // 2. One-Click Copy Email
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email') || 'thanhdora3605@gmail.com';
    try {
      await navigator.clipboard.writeText(email);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied ✓';
      copyBtn.classList.add('border-sage', 'text-sage');
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2200);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });

  // 3. Contact Form Handler
  const contactForm = document.getElementById('atelier-contact-form') as HTMLFormElement | null;
  const feedbackEl = document.getElementById('form-feedback');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(contactForm);
    const name = String(formData.get('name') || '');
    const email = String(formData.get('email') || '');
    const scope = String(formData.get('scope') || '');
    const message = String(formData.get('message') || '');

    const subject = encodeURIComponent(`[Atelier Inquiry] ${scope} — from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nMandate: ${scope}\n\nBrief:\n${message}`
    );

    if (feedbackEl) {
      feedbackEl.textContent = 'Preparing dispatch in your mail client...';
      feedbackEl.classList.add('text-sage');
    }

    window.location.href = `mailto:thanhdora3605@gmail.com?subject=${subject}&body=${body}`;
  });
</script>
