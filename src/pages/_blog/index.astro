---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROFILE_DATA } from '../../data/profile';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout
  title={`Atelier Journal & Technical Notes — ${PROFILE_DATA.identity.name}`}
  description="Essays and technical monographs on full-stack architecture, deterministic AI workflows, DevOps, and quiet software craft."
>
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <!-- Header -->
      <div class="border-b border-rule pb-10">
        <p class="font-mono text-xs uppercase tracking-widest text-sage">
          § 05 / ATELIER JOURNAL &amp; MONOGRAPHS
        </p>
        <h1 class="mt-3 font-serif text-4xl text-ink sm:text-5xl">
          Notes on <span class="italic font-normal text-sage">Systems, AI &amp; Craft</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-secondary">
          Long-form field notes written from production experience across Next.js, Node.js, native iOS, Cloudflare edge infrastructure, and applied AI operations.
        </p>
      </div>

      <!-- Articles Index -->
      <div class="divide-y divide-rule">
        {posts.map((post, index) => (
          <article class="group py-10 transition-colors">
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-ink-muted">
              <div class="flex items-center gap-2.5">
                <span class="text-sage font-semibold">MONOGRAPH 0{posts.length - index}</span>
                <span>•</span>
                <span class="rounded bg-sage/10 px-2 py-0.5 text-sage">{post.data.category}</span>
              </div>
              <div class="flex items-center gap-3">
                <span>{post.data.readingTime}</span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </div>
            </div>

            <h2 class="mt-3 font-serif text-2xl font-medium text-ink group-hover:text-sage transition-colors sm:text-3xl">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>

            {post.data.subtitle && (
              <p class="mt-1 font-serif italic text-base text-ink-secondary">{post.data.subtitle}</p>
            )}

            <p class="mt-3 text-sm leading-relaxed text-ink-secondary sm:text-base">
              {post.data.description}
            </p>

            <div class="mt-5 flex items-center justify-between">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded border border-rule bg-canvas-elevated/60 px-2.5 py-0.5 font-mono text-[11px] text-ink-muted">
                    #{tag}
                  </span>
                ))}
              </div>

              <a
                href={`/blog/${post.slug}`}
                class="font-mono text-xs font-medium text-ink group-hover:text-sage editorial-link"
              >
                Read Monograph →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
