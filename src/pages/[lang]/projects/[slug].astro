---
import ProjectPage from '../../../views/ProjectPage.astro';
import { PROFILE_DATA } from '../../../data/profile';
import { NON_DEFAULT_LOCALES, type Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.flatMap((lang) => PROFILE_DATA.projects.map((p) => ({ params: { lang, slug: p.id } })));
}
const { lang, slug } = Astro.params as { lang: Locale; slug: string };
---

<ProjectPage locale={lang} slug={slug} />
