---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE_DATA } from '../data/profile';
---

<BaseLayout
  title={`Curriculum Vitae — ${PROFILE_DATA.identity.name} (${PROFILE_DATA.identity.legalName})`}
  description={`Executive Resume and Technical Dossier of ${PROFILE_DATA.identity.name}, ${PROFILE_DATA.identity.role}.`}
>
  <section class="py-12 sm:py-20">
    <div class="mx-auto max-w-4xl px-5 sm:px-8 print-container">
      <!-- Top Control Bar (Hidden when printing) -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-rule pb-5 no-print">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-mono text-xs text-ink-muted hover:text-sage"
        >
          <span>←</span>
          <span>RETURN TO PORTFOLIO</span>
        </a>

        <div class="flex items-center gap-3">
          <button
            id="print-cv-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2 text-xs font-medium text-canvas transition-colors hover:bg-sage"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z" />
            </svg>
            <span>Print / Save as PDF</span>
          </button>
        </div>
      </div>

      <!-- CV Document Sheet -->
      <div class="rounded-2xl border border-rule bg-canvas-elevated/40 p-8 sm:p-12 print-container">
        <!-- CV Header -->
        <header class="border-b border-rule pb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-sage">CURRICULUM VITAE</p>
            <h1 class="mt-1 font-serif text-4xl font-semibold text-ink">
              {PROFILE_DATA.identity.name}{' '}
              <span class="font-normal italic text-ink-secondary text-2xl">
                ({PROFILE_DATA.identity.legalName})
              </span>
            </h1>
            <p class="mt-1.5 text-base font-medium text-ink-secondary">
              {PROFILE_DATA.identity.role}
            </p>
          </div>

          <div class="font-mono text-xs text-ink-secondary space-y-1 sm:text-right">
            <p>{PROFILE_DATA.identity.location}</p>
            <p>
              <a href={`mailto:${PROFILE_DATA.identity.email}`} class="text-ink hover:text-sage">
                {PROFILE_DATA.identity.email}
              </a>
            </p>
            <p>
              <a href={`https://${PROFILE_DATA.identity.domain}`} class="hover:text-sage">
                {PROFILE_DATA.identity.domain}
              </a>
              {' • '}
              <a href={PROFILE_DATA.identity.github} class="hover:text-sage">
                github.com/ThanhDora
              </a>
            </p>
          </div>
        </header>

        <!-- Executive Summary -->
        <section class="py-6 border-b border-rule">
          <h2 class="font-mono text-xs uppercase tracking-widest text-sage">01 / EXECUTIVE SUMMARY</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
            {PROFILE_DATA.hero.lead}
          </p>
        </section>

        <!-- Core Technical Matrix -->
        <section class="py-6 border-b border-rule">
          <h2 class="font-mono text-xs uppercase tracking-widest text-sage">02 / TECHNICAL ARCHITECTURE MATRIX</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {PROFILE_DATA.skills.map((group) => (
              <div class="rounded-lg border border-rule/70 bg-canvas/70 p-4">
                <h3 class="font-serif text-base font-medium text-ink">{group.category}</h3>
                <p class="mt-1.5 text-xs text-ink-secondary leading-relaxed">
                  {group.items.map((i) => i.name).join(' • ')}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Experience & Education -->
        <section class="py-6 border-b border-rule">
          <h2 class="font-mono text-xs uppercase tracking-widest text-sage">03 / PROFESSIONAL EXPERIENCE &amp; EDUCATION</h2>
          <div class="mt-5 space-y-6">
            {PROFILE_DATA.experience.map((exp) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-serif text-xl font-medium text-ink">
                    {exp.role} — <span class="italic font-normal text-ink-secondary">{exp.organization}</span>
                  </h3>
                  <span class="font-mono text-xs text-sage">{exp.period}</span>
                </div>
                <p class="mt-1 text-xs text-ink-secondary">{exp.summary}</p>
                <ul class="mt-2 space-y-1">
                  {exp.highlights.map((h) => (
                    <li class="flex items-start gap-2 text-xs text-ink-secondary">
                      <span class="text-sage">•</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- Selected Systems & Projects -->
        <section class="pt-6">
          <h2 class="font-mono text-xs uppercase tracking-widest text-sage">04 / SELECTED ENGINEERING SYSTEMS</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {PROFILE_DATA.projects.map((proj) => (
              <div class="rounded-lg border border-rule/70 bg-canvas/70 p-4">
                <div class="flex items-center justify-between font-mono text-[10px] text-ink-muted">
                  <span>{proj.category}</span>
                  <span>{proj.year}</span>
                </div>
                <h3 class="mt-1 font-serif text-base font-medium text-ink">{proj.title}</h3>
                <p class="mt-1 text-xs text-ink-secondary leading-relaxed">{proj.summary}</p>
                <p class="mt-2 font-mono text-[10px] text-sage">
                  Stack: {proj.stack.join(', ')}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('print-cv-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>
