---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROFILE_DATA } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title={`${post.data.title} — ${PROFILE_DATA.identity.name}`}
  description={post.data.description}
>
  <article class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <!-- Back Link -->
      <div class="mb-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-mono text-xs text-ink-muted hover:text-sage transition-colors"
        >
          <span>←</span>
          <span>BACK TO ATELIER JOURNAL</span>
        </a>
      </div>

      <!-- Article Masthead -->
      <header class="border-b border-rule pb-8">
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-ink-muted">
          <span class="rounded bg-sage/15 px-2.5 py-0.5 text-sage font-medium">
            {post.data.category}
          </span>
          <span>•</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>•</span>
          <span>{post.data.readingTime}</span>
        </div>

        <h1 class="mt-4 font-serif text-3xl leading-tight text-ink sm:text-5xl">
          {post.data.title}
        </h1>

        {post.data.subtitle && (
          <p class="mt-3 font-serif text-xl italic text-ink-secondary">
            {post.data.subtitle}
          </p>
        )}

        <div class="mt-6 flex items-center justify-between border-t border-rule/60 pt-4 font-mono text-xs text-ink-muted">
          <span>BY {PROFILE_DATA.identity.name.toUpperCase()} ({PROFILE_DATA.identity.legalName})</span>
          <div class="flex gap-2">
            {post.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        </div>
      </header>

      <!-- Rendered Markdown Body -->
      <div class="prose prose-atelier prose-lg max-w-none mt-10 font-sans leading-relaxed prose-headings:font-serif prose-headings:font-medium prose-code:font-mono prose-code:text-sm prose-pre:rounded-xl prose-pre:border prose-pre:border-rule">
        <Content />
      </div>

      <!-- Article Footer -->
      <footer class="mt-16 border-t border-rule pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="font-serif text-lg text-ink">Written by {PROFILE_DATA.identity.name}</p>
          <p class="text-xs text-ink-secondary">{PROFILE_DATA.identity.role} • {PROFILE_DATA.identity.domain}</p>
        </div>
        <div class="flex items-center gap-4 font-mono text-xs">
          <a href="/blog" class="text-ink-secondary hover:text-ink editorial-link">All Notes</a>
          <span>•</span>
          <a href="/#contact" class="text-sage hover:underline">Discuss this essay →</a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
