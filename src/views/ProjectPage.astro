---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../data/localized';
import { formatMonth, formatDay, projectPath } from '../lib/format';
import { localizePath, fmt, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const ui = t(locale);
const cat = (c: string) => ui.categories[c] ?? c;
const PROFILE_DATA = getProfile(locale);
const list = PROFILE_DATA.projects;
const index = list.findIndex((p) => p.id === slug);
const project = list[index];
const prev = list[(index - 1 + list.length) % list.length];
const next = list[(index + 1) % list.length];
const home = localizePath('/', locale);
const { identity } = PROFILE_DATA;
const total = list.length;
const strip = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const title = fmt(ui.meta.projectTitle, { title: project.title, category: cat(project.category), name: identity.name });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.title,
  description: project.summary,
  inLanguage: locale,
  codeRepository: project.repoUrl,
  programmingLanguage: project.stack,
  dateCreated: project.started,
  dateModified: project.lastCommit,
  author: { '@type': 'Person', name: identity.name, url: new URL(home, Astro.site).toString() },
  ...(project.liveUrl ? { url: project.liveUrl } : {}),
};
---

<BaseLayout locale={locale} title={title} description={project.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="py-12 sm:py-20">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <nav data-enter style="--d:0" aria-label={ui.project.breadcrumb} class="font-mono text-xs text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={home} class="hover:text-sage">{ui.project.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${home}#projects`} class="hover:text-sage">{ui.project.projects}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-secondary">{project.title}</li>
        </ol>
      </nav>

      <header class="mt-8 border-b border-rule pb-10">
        <div data-enter style="--d:1" class="flex flex-wrap items-center gap-3 font-mono text-xs text-ink-muted">
          <span class="rounded bg-sage/10 px-2 py-0.5 text-sage-deep">{cat(project.category)}</span>
          <span>{fmt(ui.project.position, { n: String(index + 1).padStart(2, '0'), total: String(total).padStart(2, '0') })}</span>
          {project.status && <span class="rounded border border-rule px-2 py-0.5">{project.status}</span>}
        </div>
        <h1 data-enter style="--d:2" class="mt-4 font-serif text-4xl font-medium leading-tight tracking-editorial text-ink sm:text-6xl">{project.title}</h1>
        <p data-enter style="--d:3" class="mt-5 max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">{project.summary}</p>

        <dl data-enter style="--d:4" class="mt-8 grid grid-cols-2 gap-4 font-mono text-xs sm:grid-cols-4">
          <div><dt class="text-ink-muted">{ui.project.started}</dt><dd class="mt-1 text-ink">{formatMonth(project.started, locale)}</dd></div>
          <div><dt class="text-ink-muted">{ui.project.lastCommit}</dt><dd class="mt-1 text-ink">{formatDay(project.lastCommit, locale)}</dd></div>
          <div><dt class="text-ink-muted">{ui.project.category}</dt><dd class="mt-1 text-ink">{cat(project.category)}</dd></div>
          <div><dt class="text-ink-muted">{ui.project.status}</dt><dd class="mt-1 text-ink">{project.status ?? (project.liveUrl ? ui.project.deployed : ui.project.sourceAvailable)}</dd></div>
        </dl>

        <div data-enter style="--d:5" class="mt-8 flex flex-wrap gap-3">
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-colors hover:bg-sage-deep">
              {ui.project.visitLive} <span aria-hidden="true">↗</span>
            </a>
          )}
          <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-rule-strong px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-sage hover:text-sage">
            {ui.project.sourceOnGitHub} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-12 py-12 lg:grid-cols-12">
        <div class="space-y-12 lg:col-span-8">
          <section data-reveal-children aria-labelledby="overview">
            <h2 id="overview" class="font-mono text-xs uppercase tracking-widest text-sage">{ui.project.overview}</h2>
            <div class="mt-4 space-y-4 text-base leading-relaxed text-ink-secondary sm:text-lg">
              {project.overview.map((p) => <p>{p}</p>)}
            </div>
            {project.note && (
              <p class="mt-5 rounded-lg border border-rule bg-canvas-elevated/60 px-4 py-3 text-sm text-ink-secondary">{project.note}</p>
            )}
          </section>

          <section data-reveal-children aria-labelledby="features">
            <h2 id="features" class="font-mono text-xs uppercase tracking-widest text-sage">{ui.project.keyFeatures}</h2>
            <ul data-reveal-children class="mt-4 space-y-3">
              {project.features.map((f) => (
                <li class="flex items-start gap-3 text-base leading-relaxed text-ink-secondary">
                  <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sage" aria-hidden="true"></span><span>{f}</span>
                </li>
              ))}
            </ul>
          </section>

          <section data-reveal-children aria-labelledby="architecture">
            <h2 id="architecture" class="font-mono text-xs uppercase tracking-widest text-sage">{ui.project.howItWorks}</h2>
            <ol data-reveal-children class="mt-4 space-y-4 border-l border-rule">
              {project.architecture.map((a, i) => (
                <li class="relative pl-6 text-base leading-relaxed text-ink-secondary">
                  <span class="absolute -left-3 top-0.5 flex h-6 w-6 items-center justify-center rounded-full border border-rule bg-canvas font-mono text-xs text-sage-deep" aria-hidden="true">{i + 1}</span>
                  {a}
                </li>
              ))}
            </ol>
          </section>
        </div>

        <aside class="lg:col-span-4">
          <div class="space-y-8 lg:sticky lg:top-24">
            <section data-reveal aria-labelledby="stack">
              <h2 id="stack" class="font-mono text-xs uppercase tracking-widest text-sage">{ui.project.techStack}</h2>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.stack.map((t) => (
                  <li class="rounded border border-rule bg-canvas px-2.5 py-1 font-mono text-xs text-ink-secondary">{t}</li>
                ))}
              </ul>
            </section>
            <section data-reveal aria-labelledby="links">
              <h2 id="links" class="font-mono text-xs uppercase tracking-widest text-sage">{ui.project.links}</h2>
              <ul class="mt-4 space-y-2 font-mono text-sm">
                {project.liveUrl && (
                  <li><span class="text-ink-muted">{ui.project.live} · </span><a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="break-all text-ink hover:text-sage">{strip(project.liveUrl)}</a></li>
                )}
                <li><span class="text-ink-muted">{ui.project.source} · </span><a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="break-all text-ink hover:text-sage">{strip(project.repoUrl).replace('github.com/', '')}</a></li>
              </ul>
            </section>
          </div>
        </aside>
      </div>

      <nav data-reveal-children aria-label={ui.project.moreProjects} class="grid grid-cols-1 gap-4 border-t border-rule pt-10 sm:grid-cols-2">
        <a href={projectPath(prev.id, locale)} class="group rounded-xl border border-rule p-5 transition-colors hover:border-sage">
          <span class="font-mono text-xs text-ink-muted">{ui.project.prev}</span>
          <span class="mt-1 block font-serif text-xl text-ink group-hover:text-sage">{prev.title}</span>
        </a>
        <a href={projectPath(next.id, locale)} class="group rounded-xl border border-rule p-5 text-right transition-colors hover:border-sage">
          <span class="font-mono text-xs text-ink-muted">{ui.project.next}</span>
          <span class="mt-1 block font-serif text-xl text-ink group-hover:text-sage">{next.title}</span>
        </a>
      </nav>
      <p data-reveal class="mt-8 text-center">
        <a href={`${home}#projects`} class="font-mono text-sm text-ink-secondary hover:text-sage editorial-link">{ui.project.backToAll}</a>
      </p>
    </div>
  </article>
</BaseLayout>
